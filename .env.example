# Create .env with ./scripts/create-env.sh on Linux/macOS or
# .\scripts\create-env.ps1 in Windows PowerShell before entering secrets.
# The helpers refuse existing paths and apply private host permissions.
# Docker Compose loads .env automatically. Never commit the populated file.

# Required credentials
# Generate four different values with: openssl rand -hex 32

# Bootstrap-only PostgreSQL superuser password. Rivune never uses this role.
RIVUNE_POSTGRES_SUPERUSER_PASSWORD=

# Password for Rivune's dedicated non-superuser application role.
RIVUNE_DATABASE_PASSWORD=

# Password used only by the non-superuser database restore role.
RIVUNE_RESTORE_PASSWORD=

# One-time token entered in the web interface during initial server setup.
RIVUNE_SETUP_TOKEN=

# Optional provider credentials
# Values are passed directly to Rivune. Leave unused credentials empty.

# Metadata provider credentials.
RIVUNE_TMDB_ACCESS_TOKEN=
RIVUNE_FANART_API_KEY=
RIVUNE_MDBLIST_API_KEY=
RIVUNE_TVDB_API_KEY=
RIVUNE_TVDB_PIN=

# Rivune's Trakt and Simkl application credentials.
# Each profile still links its own provider account from profile settings.
RIVUNE_TRAKT_CLIENT_ID=
RIVUNE_TRAKT_CLIENT_SECRET=
RIVUNE_SIMKL_CLIENT_ID=

# Hex-encoded 32-byte tracking encryption key.
# Generate with: openssl rand -hex 32
RIVUNE_TRACKING_ENCRYPTION_KEY=

# IANA timezone used for profile access dates and daily hours.
TZ=UTC

# Container identity

# Numeric UID and GID used by the non-root process inside the container.
PUID=65532
PGID=65532

# Network and image

# Public base URL shown to clients. Loopback HTTP is for local development only; every non-loopback origin must use HTTPS.
RIVUNE_PUBLIC_URL=http://localhost:8080

# Comma-separated proxy IPs or CIDR networks allowed to provide forwarding headers.
RIVUNE_TRUSTED_PROXIES=

# Optional comma-separated RFC 6052 NAT64 prefixes supplied by the trusted network operator.
# Supported lengths: /32, /40, /48, /56, /64, /96. The well-known 64:ff9b::/96 prefix is always recognized.
RIVUNE_NAT64_PREFIXES=

# Loopback host port mapped to Rivune's internal port 8080 by the default Compose file.
RIVUNE_PORT=8080

# Published GHCR image tag used by Docker Compose (for example latest or a release tag).
RIVUNE_VERSION=latest

# Initial default for the Jellyfin API adapter before an administrator saves the in-app setting.
# Accepted values are true or false; the persisted admin setting is authoritative afterward.
RIVUNE_JELLYFIN_ENABLED=false

# Opt-in bounded diagnostic metadata for Jellyfin compatibility routes. Never logs request/query/header/body values or payload bytes.
RIVUNE_JELLYFIN_DEBUG=false

# Sessions and metadata

# Session lifetimes use Go duration syntax, for example 15m, 12h, or 720h.
RIVUNE_ACCESS_TOKEN_TTL=15m
RIVUNE_REFRESH_TOKEN_TTL=720h
RIVUNE_PROFILE_GRANT_TTL=12h

# Lifetime of cached TMDB, TVDB, and Fanart.tv metadata.
RIVUNE_METADATA_CACHE_TTL=24h

# Media processing

# FFmpeg executables available inside the container.
RIVUNE_FFMPEG_PATH=ffmpeg
RIVUNE_FFPROBE_PATH=ffprobe

# Maximum concurrent remux jobs and CPU threads used by software transcoding.
RIVUNE_REMUX_CONCURRENCY=2
RIVUNE_TRANSCODE_THREADS=4

# Maximum generated video bitrate in kilobits per second. A lower client limit still wins.
RIVUNE_TRANSCODE_MAX_BITRATE_KBPS=12000

# Encoder mode: auto, software, vaapi, qsv, or nvenc.
RIVUNE_HARDWARE_ACCELERATION=auto

# Container path and host GID for the AMD/Intel render device. Verify the GID with stat; generic Compose commonly uses 109, while Unraid commonly uses 18.
RIVUNE_VIDEO_DEVICE=/dev/dri/renderD128
RIVUNE_VIDEO_GROUP_ID=109

# Temporary HLS/transcode workspace and its global storage limit in megabytes.
RIVUNE_MEDIA_TEMP_DIR=/tmp
RIVUNE_MEDIA_MAX_STORAGE_MB=20480

# Persistent provider artwork cache storage limit in megabytes.
RIVUNE_ARTWORK_MAX_STORAGE_MB=20480

# Optional comma-separated exact origins for trusted LAN artwork servers, including a LAN add-on origin when its catalogs serve artwork from that same origin. Each entry must use an IP literal and explicit port, for example http://192.168.1.20:8080; never include a path, query, token, hostname, loopback, or link-local address.
RIVUNE_LAN_ARTWORK_ORIGINS=
