# Copy this file to .env before starting Docker Compose.
# Docker Compose loads .env automatically. Never commit the populated .env file.

# Required credentials
# Generate two different values with: openssl rand -hex 32

# Password shared by Rivune and the bundled PostgreSQL service.
RIVUNE_DATABASE_PASSWORD=

# One-time token entered in the web interface during initial server setup.
RIVUNE_SETUP_TOKEN=

# Optional metadata providers
# Leave unused credentials empty.

# TMDB API Read Access Token for localized titles, artwork, and metadata.
RIVUNE_TMDB_ACCESS_TOKEN=

# TVDB project or user-supported API key for series metadata and episode ordering.
RIVUNE_TVDB_API_KEY=

# Required only with a TVDB user-supported key. Leave empty for a regular project key.
RIVUNE_TVDB_PIN=

# Trakt application client ID for Trakt-backed collection sources.
RIVUNE_TRAKT_CLIENT_ID=

# Container identity

# Numeric UID and GID used by the non-root process inside the container.
PUID=65532
PGID=65532

# Network and build

# Public base URL shown to clients. Use the external HTTPS origin behind a reverse proxy.
RIVUNE_PUBLIC_URL=http://localhost:8080

# Comma-separated proxy IPs or CIDR networks allowed to provide forwarding headers.
RIVUNE_TRUSTED_PROXIES=

# Host port mapped to Rivune's internal port 8080.
RIVUNE_PORT=8080

# Version label embedded when building the container locally.
RIVUNE_VERSION=dev

# Sessions and metadata

# Session lifetimes use Go duration syntax, for example 15m, 12h, or 720h.
RIVUNE_ACCESS_TOKEN_TTL=15m
RIVUNE_REFRESH_TOKEN_TTL=720h
RIVUNE_PROFILE_GRANT_TTL=12h

# Lifetime of cached TMDB and TVDB metadata.
RIVUNE_METADATA_CACHE_TTL=24h

# Media processing

# FFmpeg executables available inside the container.
RIVUNE_FFMPEG_PATH=ffmpeg
RIVUNE_FFPROBE_PATH=ffprobe

# Maximum concurrent remux jobs and CPU threads used by software transcoding.
RIVUNE_REMUX_CONCURRENCY=2
RIVUNE_TRANSCODE_THREADS=4

# Encoder mode: auto, software, vaapi, qsv, or nvenc.
RIVUNE_HARDWARE_ACCELERATION=auto

# Container path and host group ID for an AMD/Intel VAAPI or Quick Sync render device.
RIVUNE_VIDEO_DEVICE=/dev/dri/renderD128
RIVUNE_VIDEO_GROUP_ID=109

# Temporary HLS/transcode workspace and its global storage limit in megabytes.
RIVUNE_MEDIA_TEMP_DIR=/tmp
RIVUNE_MEDIA_MAX_STORAGE_MB=20480
