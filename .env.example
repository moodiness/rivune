# Create .env with ./scripts/create-env.sh on Linux/macOS or
# .\scripts\create-env.ps1 in Windows PowerShell before entering secrets.
# The helpers refuse existing paths and apply private host permissions.
# Docker Compose loads .env automatically. Never commit the populated file.

# Generate each password/token independently with: openssl rand -hex 32

# Bootstrap-only PostgreSQL superuser password. Rivune never uses this role.
RIVUNE_POSTGRES_SUPERUSER_PASSWORD=

# Password for Rivune's dedicated non-superuser application role.
RIVUNE_DATABASE_PASSWORD=

# Password used only by the non-superuser database restore role.
RIVUNE_RESTORE_PASSWORD=

# One-time token entered in the web interface during initial server setup.
RIVUNE_SETUP_TOKEN=

# Required active-first encryption keyring. Each positive version and key must
# be unique; keys are non-zero and exactly 64 lowercase hexadecimal characters.
# New installation example: RIVUNE_ENCRYPTION_KEYS=1:<output of openssl rand -hex 32>
# Rotation example: RIVUNE_ENCRYPTION_KEYS=2:<new key>,1:<retained old key>
RIVUNE_ENCRYPTION_KEYS=

# Complete HTTPS origin exposed through Pangolin/Newt, or a literal loopback or
# private-IP HTTP origin for a direct trusted-LAN deployment. Leave empty for
# loopback-only access. Never use cleartext HTTP across the public Internet.
RIVUNE_PUBLIC_URL=

# Origin announced to native apps through Linux host-network mDNS or the host
# publishers managed by ./rivune on macOS and .\rivune.ps1 on Windows. The
# Linux/macOS setup command copies a reachable --public-url here; leave it empty
# for loopback-only installs. HTTP still requires a literal private IP and
# RIVUNE_BIND_ADDRESS=0.0.0.0.
RIVUNE_DISCOVERY_URL=

# Human-readable DNS-SD instance name shown by native clients (63 bytes max).
RIVUNE_DISCOVERY_NAME=Rivune

# Exact stable GHCR release tag used for reproducible installation.
RIVUNE_VERSION=1.11.4

# Optional trusted-proxy override. The base Compose stack already trusts only
# its fixed 172.31.0.0/24 edge network.
RIVUNE_TRUSTED_PROXIES=

# Optional AMD/Intel acceleration. These are used only when
# compose.amd-intel.yaml is added to the Compose command.
RIVUNE_VIDEO_DEVICE=/dev/dri/renderD128
RIVUNE_VIDEO_GROUP_ID=

# Host address for the optional direct port. Keep 127.0.0.1 for host-only
# access. Set 0.0.0.0 only to expose Rivune directly to a trusted LAN, never
# to the public Internet; then use this host's private IP in RIVUNE_PUBLIC_URL.
RIVUNE_BIND_ADDRESS=127.0.0.1
RIVUNE_PORT=8080
