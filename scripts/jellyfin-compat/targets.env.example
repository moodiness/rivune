# Copy to targets.env, replace every placeholder, then chmod 600 targets.env.
# This file is sourced as Bash by run.sh; do not commit the private copy.

# Rivune must already be running and have a profile/library containing the
# synthetic title "Rivune Demo". Its Jellyfin compatibility login uses the
# profile UUID as Username.
RIVUNE_TARGET_URL=http://127.0.0.1:8080
JFCOMPAT_RIVUNE_USERNAME=00000000-0000-4000-8000-000000000000
JFCOMPAT_RIVUNE_PASSWORD=replace-with-a-private-profile-password

# These credentials are used only for the disposable, loopback Jellyfin oracle.
# run.sh creates this account through the Startup APIs on every fresh run.
JFCOMPAT_UPSTREAM_USERNAME=rivune-compat
JFCOMPAT_UPSTREAM_PASSWORD=replace-with-a-private-oracle-password

# Optional. The default is a timestamped directory below work/runs/.
# JFCOMPAT_OUT_DIR=/absolute/private/path/to/results
